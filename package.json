{
  "name": "fluent-object-stream",
  "version": "1.0.0",
  "description": "Facilitate transformation on nodeJS streams",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=16.10.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm,cjs --out-dir dist --clean --tsconfig tsconfig.build.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "prettier": "prettier --config .prettierrc 'src/**/*.ts' --write",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vdizengremel/fluent-object-stream.git"
  },
  "keywords": [
    "object",
    "stream",
    "readable",
    "transform"
  ],
  "author": "vdizengremel",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vdizengremel/fluent-object-stream/issues"
  },
  "homepage": "https://github.com/vdizengremel/fluent-object-stream#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest-formatting": "^4.0.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-security": "^4.2.1",
    "prettier": "^3.10.1",
    "semantic-release": "^26.0.1",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild": false
  }
}
