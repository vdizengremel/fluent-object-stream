{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2021"],
    "module": "ESNext",
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "allowJs": false,
    "moduleResolution": "bundler",
    "types": ["node", "jest"],
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
